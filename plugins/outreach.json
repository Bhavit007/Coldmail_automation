        "fromEmail": "={{ $('Settings').first().json.from_email }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "adf19f07-c6bd-4723-900b-bd094fab8e61",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        880,
        -100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Records whether each email was sent.\nconst sent = $('Is email?').all(0).map(i => i.json);\nreturn $input.all().map((item, i) => ({ json: { ...sent[i],\n  status: item.json.error ? 'failed' : 'sent',\n  message: item.json.error ? `${sent[i].subject}\\nError: ${item.json.error.message || item.json.error}` : sent[i].subject } }));\n"
      },
      "id": "25c1e7e7-c74d-4fd8-b891-6b7bb174e69f",
      "name": "Email result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Instagram / Facebook can't be sent automatically yet: they go to the dashboard's manual DM list.\nreturn $input.all().map(i => ({ json: { ...i.json, status: 'queued' } }));\n"
      },
      "id": "f83b5e4c-7076-4e33-a84d-78b231ebeebb",
