      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Plug-in input: one lead. One item per message: email is sent below, Instagram / Facebook go to the manual DM list.\nconst s = $('Settings').first().json;\nconst out = [];\nfor (const { json: l } of $input.all()) {\n  if (!l.id || !l.has_page) continue;\n  const link = `${String(s.page_base_url).replace(/\\/$/, '')}/webhook/page?id=${l.id}`;\n  const text = `Hi ${l.name} team! I made a free preview of a simple website for your business: ${link} - happy to put it live on your own domain if you like it. ${s.sender_name}`;\n  if (l.email) {\n    const to = s.test_mode ? s.test_email : l.email;\n    out.push({ json: { lead_id: l.id, channel: 'email', to,\n      subject: (s.test_mode ? `[TEST - real: ${l.email}] ` : '') + `A free website preview for ${l.name}`,\n      html: `<p>Hi ${l.name} team,</p><p>I put together a free preview of what a simple website for your business could look like:<br><a href=\"${link}\">${link}</a></p><p>If you like it, I can put it live on your own domain. Just reply to this email.</p><p>${s.sender_name}</p>`,\n      message: text } });\n  }\n  if (l.instagram) out.push({ json: { lead_id: l.id, channel: 'instagram', to: l.instagram, message: text } });\n  if (l.facebook) out.push({ json: { lead_id: l.id, channel: 'facebook', to: l.facebook, message: text } });\n}\nreturn out;\n"
      },
      "id": "0b3ed1b0-12b4-4ff3-b4ad-705935db1a31",
      "name": "Prepare messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "03853bcc-18ac-4b88-aad2-5f0207f36672",
              "leftValue": "={{ $json.channel === 'email' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6589f8f9-1a96-4cf3-8a5b-8a3d8c93d89e",
