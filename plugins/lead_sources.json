        "url": "={{ $json.gmaps_url }}/api/v1/jobs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.query, keywords: [$json.query], lang: 'en', depth: $json.gmaps_depth, email: $json.gmaps_emails, max_time: $json.gmaps_max_minutes * 60 }) }}",
        "options": {}
      },
      "id": "a39f866a-83b3-4d7a-b6e9-9d0822307477",
