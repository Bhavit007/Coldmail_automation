    {
      "parameters": {
        "mode": "expression",
        "numberOutputs": 4,
        "output": "={{ ({ amazon_text: 0, amazon_nearby: 0, google_maps: 1, claude_search: 2 })[$json.source] ?? 3 }}"
      },
      "id": "e3850840-93c7-4117-82cd-0dc15140d51c",
      "name": "Which source?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// amazon_text: search by words. amazon_nearby: every trade business around one point of the city grid.\nconst s = $json;\nconst nearby = s.source === 'amazon_nearby';\nconst body = nearby\n  ? { QueryPosition: [s.lng, s.lat], QueryRadius: s.nearby_radius_m, MaxResults: 100,\n      Filter: { IncludeCategories: String(s.nearby_categories).split(',').map(x => x.trim()).filter(Boolean) } }\n  : { QueryText: s.query, BiasPosition: [s.lng, s.lat], MaxResults: 100 };\nObject.assign(body, { AdditionalFeatures: ['Contact'], Language: 'en' }, s.next_token ? { NextToken: s.next_token } : {});\nreturn { json: { url: `https://places.geo.${s.aws_region}.amazonaws.com/v2/${nearby ? 'search-nearby' : 'search-text'}`, body } };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "7a972dcf-3349-4e96-8c8d-7433a8f39c46",
      "name": "Build Amazon request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "7ff2734a-83c6-48db-9ce9-a6fccfec204e",
      "name": "Amazon Location",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Businesses only (Amazon also returns towns and streets, e.g. \"Plano, TX\").\nconst r = $input.first().json;\nconst rows = (r.ResultItems || []).filter(p => !p.PlaceType || p.PlaceType === 'PointOfInterest').map(p => {\n  const c = p.Contacts || {};\n  return {\n    name: p.Title || '', category: (p.Categories || []).map(x => x.Name).join(', '),\n    address: p.Address?.Label || '', city: p.Address?.Locality || '',\n    phone: c.Phones?.[0]?.Value || '', website: c.Websites?.[0]?.Value || '', email: c.Emails?.[0]?.Value || '',\n    source: $('Lead in').first().json.source,\n  };\n});\nreturn [{ json: { rows, next_token: r.NextToken || '' } }];\n"
      },
      "id": "0b7b26ba-be3e-4d21-9804-7b87a1e7c11e",
      "name": "Amazon rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -200
      ]
    },
    {
      "parameters": {
