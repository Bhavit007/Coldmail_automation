      "id": "a7b273cf-bf59-456c-81df-792c84eab7b4",
      "name": "Download results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// The scraper's CSV -> lead rows. One job covers the whole search, so there is no next page.\nconst job = $('Check job').last().json;\nif (job.Status !== 'ok') throw new Error(`Google Maps scraper job ${job.ID} ended with status \"${job.Status}\"`);\nconst csv = String($input.first().json.data || '');\nconst table = [];\nlet row = [], f = '', q = false;\nfor (let i = 0; i < csv.length; i++) {\n  const c = csv[i];\n  if (q) { if (c === '\"') { if (csv[i + 1] === '\"') { f += '\"'; i++; } else q = false; } else f += c; }\n  else if (c === '\"') q = true;\n  else if (c === ',') { row.push(f); f = ''; }\n  else if (c === '\\n') { row.push(f); table.push(row); row = []; f = ''; }\n  else if (c !== '\\r') f += c;\n}\nif (f || row.length) { row.push(f); table.push(row); }\nconst [head = [], ...lines] = table;\nconst rows = lines.filter(l => l.length === head.length).map(l => {\n  const x = Object.fromEntries(head.map((h, i) => [h, l[i]]));\n  let a = {}; try { a = JSON.parse(x.complete_address || '{}'); } catch (e) {}\n  return { name: x.title || '', category: x.category || '', address: x.address || '', city: a.city || '',\n    phone: x.phone || '', website: x.website || '', email: (x.emails || '').split(',')[0].trim(), source: 'google_maps' };\n}).filter(r => r.name);\nreturn [{ json: { rows, next_token: '' } }];\n"
      },
      "id": "d1227c56-927d-4dca-ae59-0411b3ba8eb9",
      "name": "Google rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Claude searches the web (directories, Facebook, Yelp...) for businesses that match this search.\nconst s = $json;\nconst content = `Find up to ${s.claude_max_results} small, owner-operated local businesses for this search: \"${s.query}\".\nSearch the web: Google Maps listings, Yelp, BBB, Angi, Nextdoor, Facebook pages and local directories.\nOnly real businesses that are operating now and list a phone number. Skip franchises, national chains and directory sites.\nPrefer businesses with no website or a weak one.\nReply with only a JSON array, no other text:\n[{\"name\":\"\",\"category\":\"\",\"address\":\"\",\"city\":\"\",\"phone\":\"\",\"website\":\"\",\"email\":\"\"}]\nUse \"\" for anything you could not find. Never guess a phone number or email.`;\nreturn { json: { claude_body: { model: s.claude_model, max_tokens: 8000,\n  tools: [{ type: 'web_search_20250305', name: 'web_search', max_uses: s.claude_max_searches }],\n  messages: [{ role: 'user', content }] } } };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "4b194163-be25-4c57-b092-56d569dcc9cd",
      "name": "Build Claude request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.claude_body) }}",
        "options": {
          "timeout": 300000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1000
            }
          }
        }
      },
      "id": "203253e7-230c-4694-b2aa-bff573771e3f",
      "name": "Claude: find businesses",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        200
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Claude's JSON list -> lead rows.\nconst r = $input.first().json;\nif (r.error) throw new Error(`Claude search: ${r.error.message || JSON.stringify(r.error)}`);\nconst text = (r.content || []).filter(b => b.type === 'text').map(b => b.text).join('');\nlet list;\ntry { list = JSON.parse(text.slice(text.indexOf('['), text.lastIndexOf(']') + 1)); }\ncatch (e) { throw new Error(`Claude search: no business list in the reply (stop_reason: ${r.stop_reason})`); }\nconst rows = list.filter(x => x && x.name).map(x => ({\n  name: x.name, category: x.category || '', address: x.address || '', city: x.city || '',\n  phone: x.phone || '', website: x.website || '', email: x.email || '', source: 'claude_search' }));\nreturn [{ json: { rows, next_token: '' } }];\n"
      },
      "id": "89eaf83b-e6fc-4518-aeee-96a8c1881b27",
      "name": "Claude rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ]
